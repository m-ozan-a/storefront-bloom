# Storefront API Configuration
# NEXT_PUBLIC_OWUAN_API_URL artık OPSİYONEL.
# - Geliştirme: otomatik olarak http://localhost:3000 kullanır
# - Production (Vercel): otomatik olarak https://app.owuan.com kullanır
# - Özel override: set ettiğinde override çalışır (örn: preview ortamı)
# NEXT_PUBLIC_OWUAN_API_URL=https://app.owuan.com

NEXT_PUBLIC_STORE_SLUG=luna-tekstil
OWUAN_STORE_API_KEY=

# CDN for images
NEXT_PUBLIC_CDN_URL=https://cdn.owuan.com

# Site
NEXT_PUBLIC_SITE_URL=
